#!/usr/bin/env bash
# From a fresh clone to the running app, in one command:   ./start
#
# It installs what Clipper needs inside this folder (nothing system-wide), then opens the app:
#   .tools/uv      uv, which fetches Python (.tools/python) and the Python packages (.venv)
#   .tools/node    Node.js, only if you have none and the app's pages need building
# The app itself downloads ffmpeg and the face model on its first start, and asks for your
# AI provider's API key on its setup page. Arguments are passed on to `clipper serve`.
set -euo pipefail
cd "$(dirname "$0")"

NODE_VERSION=v24.18.0
say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

OS=$(uname -s)
if [ "$OS" = Darwin ]; then
  [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = 1 ] \
    || die "Clipper needs an Apple Silicon Mac (or Linux): its speech and face models have no Intel Mac builds."
  # A terminal running under Rosetta would install Intel builds of everything: go native first.
  [ "$(uname -m)" = arm64 ] || exec arch -arm64 /bin/bash "$0" "$@"
fi
command -v curl >/dev/null || die "curl is needed to download Clipper's tools. Install it and run ./start again."

# --- uv: ours, unless the one on PATH is right for this machine ---------------------------------
native() {    # is this program built for this machine? (an Intel uv on Apple Silicon is not)
  [ "$OS" != Darwin ] || file -L "$1" 2>/dev/null | grep -q arm64
}
UV=$(command -v uv || true)
if [ -z "$UV" ] || ! native "$UV"; then
  UV="$PWD/.tools/uv/uv"
  if [ ! -x "$UV" ]; then
    say "Installing uv into .tools/uv"
    curl -LsSf https://astral.sh/uv/install.sh \
      | env UV_UNMANAGED_INSTALL="$PWD/.tools/uv" sh >/dev/null
  fi
fi

# --- Python packages ----------------------------------------------------------------------------
if [ -x .venv/bin/python ] && ! native .venv/bin/python; then
  say "Rebuilding .venv: it was made with an Intel Python"
  rm -rf .venv
fi
say "Checking Python packages (the first run downloads about 1 GB)"
# Its own Python, kept in this folder: another copy elsewhere may be the wrong kind for this machine.
export UV_PYTHON_INSTALL_DIR="$PWD/.tools/python"
"$UV" sync --python-preference only-managed

# --- the app's pages: built once, and again when their source changes ----------------------------
stale() {
  [ ! -f frontend/dist/index.html ] || [ -n "$(find frontend/src frontend/index.html \
    frontend/package.json -newer frontend/dist/index.html -print -quit 2>/dev/null)" ]
}
if stale; then
  if ! command -v npm >/dev/null; then
    case "$OS-$(uname -m)" in
      Darwin-arm64) NODE=darwin-arm64 ;;
      Linux-x86_64) NODE=linux-x64 ;;
      Linux-aarch64) NODE=linux-arm64 ;;
      *) die "Install Node.js (nodejs.org), then run ./start again." ;;
    esac
    if [ ! -x .tools/node/bin/npm ]; then
      say "Installing Node.js into .tools/node"
      FILE="node-$NODE_VERSION-$NODE.tar.gz"
      TMP=$(mktemp -d)
      curl -fsSL -o "$TMP/$FILE" "https://nodejs.org/dist/$NODE_VERSION/$FILE"
      curl -fsSL -o "$TMP/sums" "https://nodejs.org/dist/$NODE_VERSION/SHASUMS256.txt"
      SUM=$(command -v sha256sum >/dev/null && echo sha256sum || echo "shasum -a 256")
      (cd "$TMP" && grep " $FILE\$" sums | $SUM -c - >/dev/null) \
        || die "The Node.js download didn't match its checksum."
      mkdir -p .tools/node
      tar -xzf "$TMP/$FILE" -C .tools/node --strip-components 1
      rm -rf "$TMP"
    fi
    PATH="$PWD/.tools/node/bin:$PATH"
  fi
  say "Building the app's pages"
  (cd frontend && npm ci --silent --no-fund --no-audit && npm run --silent build)
fi

exec .venv/bin/python -m clipper.cli serve "$@"
